<div class="time-entries-page__header">
  <div>
    <h1 class="time-entries-page__title">Billing Report</h1>
    <p class="page-intro">Revenue and billing categories for <%= @billing_summary_month.strftime("%B %Y") %>.</p>
  </div>
</div>

<div class="card time-entries-toolbar">
  <form method="get" action="<%= billing_path %>" class="time-entries-toolbar__filter">
    <div class="time-entries-toolbar__filters">
      <div class="time-entries-toolbar__field">
        <label for="month">Month</label>
        <input type="month" id="month" name="month" value="<%= @billing_summary_month.strftime("%Y-%m") %>">
      </div>
    </div>
    <div class="time-entries-toolbar__actions">
      <button type="submit" class="btn">Apply</button>
      <%= link_to "This month", billing_path(month: Date.current.strftime("%Y-%m")), class: "btn secondary" %>
    </div>
  </form>
</div>

<div class="projects-period-nav">
  <%= link_to "Previous month",
              billing_path(month: @billing_summary_month.prev_month.strftime("%Y-%m")),
              class: "projects-period-nav__link" %>
  <span class="projects-period-nav__label"><%= @billing_summary_month.strftime("%B %Y") %></span>
  <%= link_to "Next month",
              billing_path(month: @billing_summary_month.next_month.strftime("%Y-%m")),
              class: "projects-period-nav__link" %>
</div>

<% estimated_revenue_total = estimated_eur_total(@billing_summary.revenue_amounts_by_currency) %>
<% billing_report_total = if estimated_revenue_total.present?
  format_money_amount(estimated_revenue_total, "EUR")
elsif CurrencyEstimate.relevant?(@billing_summary.revenue_amounts_by_currency)
  "Set EUR/USD rate"
else
  "-"
end %>

<div class="billing-report-grid">
  <div class="card billing-summary-card">
    <div class="billing-card__header">
      <div>
        <div class="dashboard-billing-heading">
          <h2 class="card-title">Billing Summary</h2>
          <span class="dashboard-billing-total dashboard-billing-total--primary">
            <strong><%= billing_report_total %></strong>
          </span>
        </div>
        <p class="section-copy"><%= @billing_summary_month.strftime("%B %Y") %></p>
      </div>
    </div>

    <% if eur_exchange_rate_label.present? %>
      <p class="section-copy dashboard-billing-rate"><%= eur_exchange_rate_label %></p>
    <% elsif CurrencyEstimate.relevant?(@billing_summary.revenue_amounts_by_currency) %>
      <p class="section-copy dashboard-billing-rate">Store a EUR/USD rate to include USD in the estimate.</p>
    <% end %>

    <div class="billing-breakdown">
      <%= link_to time_entries_path(start_date: @billing_summary_month.to_s, end_date: @billing_summary_month.end_of_month.to_s, billing_category: "invoiceable"), class: "billing-breakdown__item billing-breakdown__item--link" do %>
        <span>Invoiceable</span>
        <strong><%= @billing_summary.invoiceable_hours.positive? ? format_money_totals(@billing_summary.invoiceable_amounts_by_currency, empty_label: "-") : "-" %></strong>
        <small><%= format_hours_as_clock_with_unit(@billing_summary.invoiceable_hours) %></small>
      <% end %>
      <%= link_to time_entries_path(start_date: @billing_summary_month.to_s, end_date: @billing_summary_month.end_of_month.to_s, billing_category: "retainer"), class: "billing-breakdown__item billing-breakdown__item--link" do %>
        <span>Retainer</span>
        <strong><%= format_money_totals(@billing_summary.retainer_amounts_by_currency, empty_label: "-") %></strong>
        <small>
          <% if @billing_summary.retainer_budget_hours.positive? %>
            <%= format_hours_ratio_as_clock_with_unit(@billing_summary.retainer_hours, @billing_summary.retainer_budget_hours) %>
          <% else %>
            <%= format_hours_as_clock_with_unit(@billing_summary.retainer_hours) %>
          <% end %>
        </small>
      <% end %>
      <%= link_to time_entries_path(start_date: @billing_summary_month.to_s, end_date: @billing_summary_month.end_of_month.to_s, billing_category: "quoted_fixed"), class: "billing-breakdown__item billing-breakdown__item--link" do %>
        <span>Quoted/fixed</span>
        <strong><%= format_money_totals(@billing_summary.quoted_fixed_billed_amounts_by_currency, empty_label: "-") %></strong>
        <small><%= format_hours_as_clock_with_unit(@billing_summary.quoted_fixed_hours) %></small>
      <% end %>
      <%= link_to time_entries_path(start_date: @billing_summary_month.to_s, end_date: @billing_summary_month.end_of_month.to_s, billing_category: "included_maintenance"), class: "billing-breakdown__item billing-breakdown__item--link" do %>
        <span>Maintenance</span>
        <strong><%= format_money_totals(@billing_summary.included_maintenance_amounts_by_currency, empty_label: "-") %></strong>
        <small><%= format_hours_as_clock_with_unit(@billing_summary.non_retainer_included_maintenance_hours) %></small>
      <% end %>
      <%= link_to time_entries_path(start_date: @billing_summary_month.to_s, end_date: @billing_summary_month.end_of_month.to_s, billing_category: "not_charged"), class: "billing-breakdown__item billing-breakdown__item--link" do %>
        <span>No charge</span>
        <strong><%= format_hours_as_clock_with_unit(@billing_summary.not_charged_hours) %></strong>
      <% end %>
    </div>
  </div>

  <div class="card billing-revenue-card">
    <div class="billing-card__header">
      <div>
        <h2 class="card-title">Revenue Share</h2>
        <p class="section-copy">By billing category and currency.</p>
      </div>
    </div>

    <% if @revenue_share_charts.any? %>
      <div class="billing-revenue-charts">
        <% @revenue_share_charts.each do |chart| %>
          <div class="billing-revenue-chart">
            <div class="billing-revenue-chart__header">
              <div>
                <strong><%= format_money_amount(chart[:total], chart[:currency]) %></strong>
                <% if chart[:currency] == CurrencyEstimate::SOURCE_CURRENCY %>
                  <small class="money-estimate"><%= estimated_eur_totals_line(chart[:currency] => chart[:total]) %></small>
                <% end %>
              </div>
              <span><%= chart[:currency] %></span>
            </div>
            <div class="billing-revenue-chart__canvas">
              <canvas data-billing-revenue-share-chart
                      data-billing-chart-currency="<%= chart[:currency] %>"
                      data-billing-chart-labels="<%= json_escape(chart[:labels].to_json) %>"
                      data-billing-chart-values="<%= json_escape(chart[:values].to_json) %>"
                      data-billing-chart-colors="<%= json_escape(chart[:colors].to_json) %>"
                      aria-label="Revenue share for <%= chart[:currency] %>"></canvas>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="form-note">No revenue values set for this month.</p>
    <% end %>
  </div>
</div>
