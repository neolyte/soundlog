<div class="time-entries-page__header">
  <div>
    <h1 class="time-entries-page__title">Dashboard</h1>
    <p class="page-intro">A quick read on recent logged time, active projects, and latest activity.</p>
  </div>
</div>

<div class="dashboard-stats">
  <div class="card dashboard-stat-card">
    <div class="dashboard-stat-card__value"><%= @total_clients %></div>
    <div class="dashboard-stat-card__label">Clients</div>
  </div>
  <div class="card dashboard-stat-card">
    <div class="dashboard-stat-card__value"><%= @total_projects %></div>
    <div class="dashboard-stat-card__label">Active Projects</div>
  </div>
  <div class="card dashboard-stat-card">
    <div class="dashboard-stat-card__value"><%= @total_time_entries %></div>
    <div class="dashboard-stat-card__label">Time Entries</div>
  </div>
  <div class="card dashboard-stat-card">
    <div class="dashboard-stat-card__value"><%= format_hours_as_clock(@hours_in_chart_range) %></div>
    <div class="dashboard-stat-card__label">Hours In Range</div>
  </div>
</div>

<% if @show_billing_summary %>
  <div class="card dashboard-billing-card">
    <div class="dashboard-section__header">
      <div>
        <h2 class="section-title">Billing This Month</h2>
        <p class="section-copy"><%= @billing_summary_month.strftime("%B %Y") %></p>
      </div>
    </div>

    <div class="billing-breakdown billing-breakdown--dashboard">
      <div class="billing-breakdown__item">
        <span>Invoiceable open</span>
        <strong><%= format_hours_as_clock(@billing_summary.invoiceable_open_hours) %></strong>
        <small><%= @billing_summary.invoiceable_open_hours.positive? ? format_money_totals(@billing_summary.invoiceable_open_amounts_by_currency) : "No open work" %></small>
        <% if @billing_summary.invoiceable_open_hours_without_rate.positive? %>
          <small><%= format_hours_as_clock(@billing_summary.invoiceable_open_hours_without_rate) %> without rate</small>
        <% end %>
      </div>
      <div class="billing-breakdown__item">
        <span>Included maintenance</span>
        <strong><%= format_hours_as_clock(@billing_summary.included_maintenance_hours) %></strong>
        <% if @billing_summary.included_maintenance_budget_hours.positive? %>
          <small>of <%= format_hours_as_clock(@billing_summary.included_maintenance_budget_hours) %> included</small>
        <% end %>
      </div>
      <div class="billing-breakdown__item">
        <span>Quoted/fixed</span>
        <strong><%= format_hours_as_clock(@billing_summary.quoted_fixed_hours) %></strong>
      </div>
      <div class="billing-breakdown__item">
        <span>No charge</span>
        <strong><%= format_hours_as_clock(@billing_summary.not_charged_hours) %></strong>
      </div>
    </div>

    <% maintenance_usages = @billing_summary.maintenance_usages.select { |usage| usage.hours.positive? || usage.included_hours? }.first(5) %>
    <% if maintenance_usages.any? %>
      <div class="maintenance-usage-list">
        <% maintenance_usages.each do |usage| %>
          <%= link_to project_path(usage.project), class: "maintenance-usage-list__row" do %>
            <span><%= usage.project.name %></span>
            <strong>
              <%= format_hours_as_clock(usage.hours) %>
              <% if usage.included_hours? %>
                of <%= format_hours_as_clock(usage.included_hours) %>
              <% end %>
            </strong>
            <% if usage.above_included? %>
              <em>above plan</em>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="card dashboard-chart-card">
  <div class="dashboard-section__header">
    <div>
      <h2 class="section-title">Hours Logged</h2>
      <p class="section-copy"><%= @dashboard_chart_range_label %> by logged entry date.</p>
    </div>
    <div class="dashboard-chart-card__meta">
      <strong><%= format_hours_as_clock(@hours_in_chart_range) %></strong>
      <span>Total</span>
    </div>
  </div>
  <% chart_range_days = (@dashboard_chart_end_date - @dashboard_chart_start_date).to_i + 1 %>
  <% chart_display_params = { hide_weekends: ("1" if @dashboard_hide_weekends) }.compact %>
  <div class="dashboard-chart-controls">
    <div class="projects-period-nav dashboard-chart-controls__nav">
      <%= link_to "Previous range",
                  root_path(chart_display_params.merge(start_date: (@dashboard_chart_start_date - chart_range_days).to_s, end_date: (@dashboard_chart_end_date - chart_range_days).to_s)),
                  class: "projects-period-nav__link" %>
      <span class="projects-period-nav__label"><%= pluralize(chart_range_days, "day") %></span>
      <%= link_to "Next range",
                  root_path(chart_display_params.merge(start_date: (@dashboard_chart_start_date + chart_range_days).to_s, end_date: (@dashboard_chart_end_date + chart_range_days).to_s)),
                  class: "projects-period-nav__link" %>
      <%= link_to "Last 7 days", root_path(chart_display_params), class: "projects-period-nav__link" %>
    </div>
    <form method="get" action="<%= root_path %>" class="dashboard-chart-controls__form">
      <div class="time-entries-toolbar__field">
        <label for="dashboard_chart_start_date">Start date</label>
        <input type="date" id="dashboard_chart_start_date" name="start_date" value="<%= @dashboard_chart_start_date %>" data-date-placeholder="Start">
      </div>
      <div class="time-entries-toolbar__field">
        <label for="dashboard_chart_end_date">End date</label>
        <input type="date" id="dashboard_chart_end_date" name="end_date" value="<%= @dashboard_chart_end_date %>" data-date-placeholder="End">
      </div>
      <label class="dashboard-chart-controls__toggle" for="dashboard_hide_weekends">
        <input type="checkbox" id="dashboard_hide_weekends" name="hide_weekends" value="1" data-dashboard-chart-auto-submit <%= "checked" if @dashboard_hide_weekends %>>
        <span>Hide weekends</span>
      </label>
      <button type="submit" class="btn secondary">Apply</button>
    </form>
  </div>
  <div class="dashboard-chart-card__canvas">
    <canvas data-dashboard-hours-chart
            data-dashboard-chart-labels="<%= json_escape(@dashboard_chart_labels.to_json) %>"
            data-dashboard-chart-values="<%= json_escape(@dashboard_chart_values.to_json) %>"
            data-dashboard-chart-projects="<%= json_escape(@dashboard_chart_projects.to_json) %>"></canvas>
  </div>
</div>

<div class="dashboard-grid">
  <div class="dashboard-grid__column">
    <div class="dashboard-section__header">
      <div>
        <h2 class="section-title">Latest Time Entries</h2>
        <p class="section-copy">The 7 most recent logged entries.</p>
      </div>
      <%= link_to "View all", time_entries_path, class: "btn secondary" %>
    </div>

    <% if @recent_time_entries.any? %>
      <div class="card time-entries-ledger">
        <% @recent_time_entries.each do |entry| %>
          <% accent = project_accent_colors(entry.project) %>
          <div class="time-entry-ledger__item" style="--project-accent: <%= accent[:strong] %>; --project-accent-soft: <%= accent[:soft] %>;">
            <div class="time-entry-ledger__row clickable-row" data-row-link="<%= time_entry_path(entry) %>" tabindex="0">
              <div class="time-entry-ledger__who">
                <div class="time-entry-ledger__owner"><%= entry.user.full_name %></div>
                <div class="time-entry-ledger__date"><%= entry.date.strftime("%d/%m/%Y") %></div>
              </div>
              <div class="time-entry-ledger__project">
                <div class="time-entry-ledger__project-line">
                  <strong><%= entry.project.name %></strong> <span>(<%= entry.project.client.name %>)</span>
                </div>
                <div class="time-entry-ledger__description"><%= entry.description.presence || "No description" %></div>
              </div>
              <div class="time-entry-ledger__hours">
                <span class="time-entry-ledger__hours-value"><%= format_hours_as_clock(entry.hours) %></span>
                <span class="time-entry-ledger__status <%= time_entry_status_class(entry) %>"><%= time_entry_status_label(entry) %></span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="card">
        <p>No time entries yet.</p>
      </div>
    <% end %>
  </div>

  <div class="dashboard-grid__column">
    <div class="dashboard-section__header">
      <div>
        <h2 class="section-title">Active Projects</h2>
        <p class="section-copy">The 7 most recently active projects.</p>
      </div>
      <%= link_to "View all", projects_path, class: "btn secondary" %>
    </div>

    <% if @recent_projects.any? %>
      <div class="card time-entries-ledger projects-ledger">
        <% @recent_projects.each do |project| %>
          <% accent = project_accent_colors(project) %>
          <div class="time-entry-ledger__item" style="--project-accent: <%= accent[:strong] %>; --project-accent-soft: <%= accent[:soft] %>;">
            <div class="time-entry-ledger__row projects-ledger__row clickable-row" data-row-link="<%= project_path(project, source: 'projects') %>" tabindex="0">
              <div class="time-entry-ledger__project projects-ledger__project">
                <div class="time-entry-ledger__project-line">
                  <strong><%= project.name %></strong>
                </div>
                <div class="time-entry-ledger__description"><%= project.client.name %></div>
              </div>
              <div class="time-entry-ledger__hours projects-ledger__hours">
                <%= render "projects/budget_progress",
                           project:,
                           logged_hours: project.total_hours_logged,
                           retainer_month: Date.current %>
              </div>
              <div class="time-entry-ledger__who projects-ledger__who">
                <div class="projects-ledger__entry-label">Last entry</div>
                <% latest_entry = project.latest_time_entry %>
                <div class="time-entry-ledger__owner"><%= latest_entry&.user&.full_name || "No entries yet" %></div>
                <div class="time-entry-ledger__date"><%= latest_entry.present? ? latest_entry.date.strftime('%d/%m/%Y') : "No activity yet" %></div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="card">
        <p>No active projects yet.</p>
      </div>
    <% end %>
  </div>
</div>
