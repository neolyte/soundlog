<div class="card time-entries-toolbar">
  <form method="get" action="<%= action_path %>" class="time-entries-toolbar__filter">
    <%= hidden_fields_tags(hidden_fields || {}) %>

    <div class="time-entries-toolbar__filters">
      <div class="time-entries-toolbar__field">
        <label for="<%= dom_id %>_start_date">Start date</label>
        <input type="date" id="<%= dom_id %>_start_date" name="start_date" value="<%= filter_start_date %>" data-date-placeholder="Start">
      </div>
      <div class="time-entries-toolbar__field">
        <label for="<%= dom_id %>_end_date">End date</label>
        <input type="date" id="<%= dom_id %>_end_date" name="end_date" value="<%= filter_end_date %>" data-date-placeholder="End">
      </div>
      <div class="time-entries-toolbar__field time-entries-toolbar__field--search">
        <label for="<%= dom_id %>_query">Search</label>
        <input type="search" id="<%= dom_id %>_query" name="query" value="<%= filter_query %>" placeholder="<%= search_placeholder %>">
      </div>
      <% if local_assigns[:status_options].present? %>
        <div class="time-entries-toolbar__field time-entries-toolbar__field--status">
          <label for="<%= dom_id %>_status">Billing</label>
          <select id="<%= dom_id %>_status" name="status">
            <option value="">All statuses</option>
            <% status_options.each do |value, label| %>
              <option value="<%= value %>" <%= "selected" if value == local_assigns[:filter_status] %>><%= label %></option>
            <% end %>
          </select>
        </div>
      <% end %>
    </div>
    <div class="time-entries-toolbar__actions">
      <button type="submit" class="btn">Filter</button>
      <%= link_to "Reset", reset_path, class: "btn secondary" %>
    </div>
  </form>
</div>
