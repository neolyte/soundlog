<h1>New Project</h1>

<div class="form-shell">
  <form method="post" action="<%= projects_path %>">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

    <% if @project.errors.any? %>
      <div class="error_explanation">
        <h2><%= pluralize(@project.errors.count, "error") %> prohibited this project from being saved:</h2>
        <ul>
          <% @project.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if @client.present? %>
      <p class="page-intro page-intro--spaced">Creating a project for <strong><%= @client.name %></strong>.</p>
    <% else %>
      <p class="page-intro page-intro--spaced">Choose a client, then set the project details.</p>
    <% end %>

    <div class="form-group">
      <label for="project_client_id">Client</label>
      <select id="project_client_id" name="project[client_id]" required>
        <option value="">Select a client...</option>
        <% @available_clients.each do |client| %>
          <option value="<%= client.id %>" <%= "selected" if @project.client_id == client.id %>>
            <%= client.name %>
          </option>
        <% end %>
      </select>
    </div>

    <div class="form-group">
      <label for="project_name">Project Name</label>
      <input type="text" id="project_name" name="project[name]" value="<%= @project.name %>" required>
    </div>

    <div class="form-group">
      <label for="project_description">Description (optional)</label>
      <textarea id="project_description" name="project[description]"><%= @project.description %></textarea>
    </div>

    <div class="form-group">
      <label for="project_service_names">Service Names (optional)</label>
      <textarea id="project_service_names" name="project[service_names]" rows="4" placeholder="One service per line"><%= @project.service_names %></textarea>
      <p class="form-note">Adds a project-only service selector and filter for this project's time entries.</p>
    </div>

    <% accent = project_accent_colors(@project) %>
    <div class="form-group">
      <label for="project_color">Project Color (optional)</label>
      <div class="color-picker-field">
        <input type="hidden" name="project[color]" value="<%= @project.color %>" data-project-color-value>
        <input type="color" id="project_color" value="<%= @project.color.presence || accent[:strong] %>" class="color-picker-field__input" data-project-color-picker>
        <span class="color-picker-field__value" data-project-color-label><%= @project.color.presence || "Generated from project name" %></span>
        <button type="button" class="btn-link color-picker-field__reset" data-project-color-clear>Use generated</button>
      </div>
      <p class="form-note">Used for project accents and dashboard chart bars.</p>
    </div>

    <div class="form-group">
      <label for="project_total_hours">Total Hours Sold (optional)</label>
      <input type="number" id="project_total_hours" name="project[total_hours]" value="<%= @project.total_hours %>" min="0" step="0.25">
      <p class="form-note">Use this for a fixed project budget.</p>
    </div>

    <div class="form-group">
      <div class="paired-fields">
        <div class="paired-fields__primary">
          <label for="project_sold_amount">Sold Amount (optional)</label>
          <input type="number" id="project_sold_amount" name="project[sold_amount]" value="<%= @project.sold_amount %>" min="0" step="0.01">
        </div>
        <div class="paired-fields__secondary">
          <label for="project_sold_currency">Currency</label>
          <select id="project_sold_currency" name="project[sold_currency]">
            <option value="">Select...</option>
            <% Project::SOLD_CURRENCIES.each do |currency| %>
              <option value="<%= currency %>" <%= "selected" if @project.sold_currency == currency %>><%= currency %></option>
            <% end %>
          </select>
        </div>
      </div>
      <p class="form-note">Optional commercial amount for non-retainer projects.</p>
    </div>

    <div class="form-group">
      <label for="project_monthly_retainer_hours">Monthly Retainer Hours (optional)</label>
      <input type="number" id="project_monthly_retainer_hours" name="project[monthly_retainer_hours]" value="<%= @project.monthly_retainer_hours %>" min="0" step="0.25">
      <p class="form-note">Use this for projects that renew the same hour budget every calendar month. Retainer sold amounts are not tracked yet.</p>
    </div>

    <div class="form-group">
      <label for="project_billable">
        <input type="hidden" name="project[billable]" value="0">
        <input type="checkbox" id="project_billable" name="project[billable]" value="1" <%= "checked" unless @project.billable == false %>>
        Billable project
      </label>
      <p class="form-note">Time entries default to billable when this is checked.</p>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn">Create Project</button>
      <%= link_to "Cancel", (@client ? client_path(@client) : projects_path), class: "btn secondary" %>
    </div>
  </form>
</div>
