<h1>Edit Project</h1>

<div class="form-shell">
  <form method="post" action="<%= project_path(@project) %>">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <input type="hidden" name="_method" value="patch">
    <% if project_navigation_from_projects? %>
      <input type="hidden" name="source" value="projects">
    <% end %>

    <% if @project.errors.any? %>
      <div class="error_explanation">
        <h2><%= pluralize(@project.errors.count, "error") %> prohibited this project from being saved:</h2>
        <ul>
          <% @project.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <p class="page-intro page-intro--spaced">Client: <strong><%= @project.client.name %></strong></p>

    <div class="form-group">
      <label for="project_name">Project Name</label>
      <input type="text" id="project_name" name="project[name]" value="<%= @project.name %>" required>
    </div>

    <div class="form-group">
      <label for="project_description">Description (optional)</label>
      <textarea id="project_description" name="project[description]"><%= @project.description %></textarea>
    </div>

    <div class="form-group">
      <label for="project_service_names">Service Names (optional)</label>
      <textarea id="project_service_names" name="project[service_names]" rows="4" placeholder="One service per line"><%= @project.service_names %></textarea>
      <p class="form-note">Adds a project-only service selector and filter for this project's time entries.</p>
    </div>

    <% accent = project_accent_colors(@project) %>
    <div class="form-group">
      <label for="project_color">Project Color (optional)</label>
      <div class="color-picker-field">
        <input type="hidden" name="project[color]" value="<%= @project.color %>" data-project-color-value>
        <input type="color" id="project_color" value="<%= @project.color.presence || accent[:strong] %>" class="color-picker-field__input" data-project-color-picker>
        <span class="color-picker-field__value" data-project-color-label><%= @project.color.presence || "Generated from project name" %></span>
        <button type="button" class="btn-link color-picker-field__reset" data-project-color-clear>Use generated</button>
      </div>
      <p class="form-note">Used for project accents and dashboard chart bars.</p>
    </div>

    <div class="form-group">
      <label for="project_billing_treatment">Default Billing Treatment</label>
      <select id="project_billing_treatment" name="project[billing_treatment]" data-project-billing-treatment-select>
        <% project_billing_treatment_options.each do |label, value| %>
          <option value="<%= value %>" <%= "selected" if @project.billing_treatment == value %>><%= label %></option>
        <% end %>
      </select>
      <p class="form-note">Time entries inherit this unless you override them individually.</p>
    </div>

    <div class="form-group" data-project-billing-field="retainer">
      <label for="project_monthly_retainer_hours">Monthly Included Hours</label>
      <input type="number" id="project_monthly_retainer_hours" name="project[monthly_retainer_hours]" value="<%= @project.monthly_retainer_hours %>" min="0" step="0.25" data-project-monthly-included-hours data-project-billing-required="retainer">
      <p class="form-note">Use this for included support, retainer, or advisory capacity that renews every calendar month.</p>
    </div>

    <div class="form-group" data-project-billing-field="invoiceable retainer">
      <div class="paired-fields">
        <div class="paired-fields__primary">
          <label for="project_hourly_rate">Hourly Rate</label>
          <input type="number" id="project_hourly_rate" name="project[hourly_rate]" value="<%= @project.hourly_rate %>" min="0" step="0.01">
        </div>
        <div class="paired-fields__secondary">
          <label for="project_hourly_rate_currency">Currency</label>
          <select id="project_hourly_rate_currency" name="project[hourly_rate_currency]">
            <option value="">Select...</option>
            <% Project::SOLD_CURRENCIES.each do |currency| %>
              <option value="<%= currency %>" <%= "selected" if @project.hourly_rate_currency == currency %>><%= currency %></option>
            <% end %>
          </select>
        </div>
      </div>
      <p class="form-note">Used to estimate open invoiceable revenue and retainer budget or overage.</p>
    </div>

    <div class="form-group" data-project-billing-field="quoted_fixed">
      <label for="project_total_hours">Total Hours Sold (optional)</label>
      <input type="number" id="project_total_hours" name="project[total_hours]" value="<%= @project.total_hours %>" min="0" step="0.25">
      <p class="form-note">Use this for a fixed project budget.</p>
    </div>

    <div class="form-group" data-project-billing-field="included_maintenance quoted_fixed">
      <div class="paired-fields">
        <div class="paired-fields__primary">
          <label for="project_sold_amount">Revenue Amount (optional)</label>
          <input type="number" id="project_sold_amount" name="project[sold_amount]" value="<%= @project.sold_amount %>" min="0" step="0.01">
        </div>
        <div class="paired-fields__secondary">
          <label for="project_sold_currency">Currency</label>
          <select id="project_sold_currency" name="project[sold_currency]">
            <option value="">Select...</option>
            <% Project::SOLD_CURRENCIES.each do |currency| %>
              <option value="<%= currency %>" <%= "selected" if @project.sold_currency == currency %>><%= currency %></option>
            <% end %>
          </select>
        </div>
      </div>
      <p class="form-note">Optional fixed contract amount or monthly hosting value.</p>
    </div>

    <div class="form-group">
      <label for="project_billable">
        <input type="hidden" name="project[billable]" value="0">
        <input type="checkbox" id="project_billable" name="project[billable]" value="1" <%= "checked" if @project.billable? %>>
        Billable project
      </label>
      <p class="form-note">Sets the default Billable entry checkbox for time logged on this project.</p>
    </div>

    <div class="form-group">
      <label for="project_active">
        <input type="hidden" name="project[active]" value="0">
        <input type="checkbox" id="project_active" name="project[active]" value="1" <%= "checked" if @project.active? %>>
        Active project
      </label>
      <p class="form-note">Archived projects are hidden from project lists and project pickers.</p>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn">Update Project</button>
      <a href="<%= project_path(@project) %>" class="btn secondary">Cancel</a>
    </div>
  </form>
</div>
