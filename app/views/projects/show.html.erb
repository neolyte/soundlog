<div class="page-header">
  <div class="page-header__body">
    <h1 class="page-title"><%= @project.name %></h1>
    <p class="page-intro">
      <%= link_to @project.client.name, client_path(@project.client) %> •
      Owner: <%= @project.client.user.full_name %>
    </p>
    <% if @project.archived? %>
      <p class="form-note status-note">Archived project</p>
    <% end %>
  </div>
  <div class="action-buttons">
    <%= button_to(@project.active? ? "Archive" : "Unarchive",
                  project_path(@project, project_navigation_params),
                  method: :patch,
                  params: { source: params[:source], project: { active: @project.archived? } },
                  class: "btn #{@project.active? ? 'archive' : 'unarchive'}") %>
    <%= link_to "Edit", edit_project_path(@project, project_navigation_params), class: "btn secondary" %>
    <%= button_to "Delete", project_path(@project), method: :delete, class: "btn danger", form: { data: { turbo_confirm: "Are you sure you want to delete this project?" } } %>
  </div>
</div>

<% if @project.description.present? %>
  <div class="card">
    <h3 class="card-title">Description</h3>
    <p class="project-description"><%= @project.description %></p>
  </div>
<% end %>

<div class="project-summary-grid">
  <div class="card">
    <p><strong>Hours Logged:</strong> <%= format_hours_as_clock(@project.total_hours_logged) %></p>
    <p><strong>Unbilled Hours:</strong> <%= format_hours_as_clock(@project.unbilled_hours) %></p>
    <p>
      <strong>Billing Treatment:</strong>
      <span class="billing-treatment-badge <%= billing_treatment_class(@project.billing_treatment) %>"><%= @project.billing_treatment_label %></span>
    </p>
    <% if @project.hourly_rate? %>
      <p><strong>Hourly Rate:</strong> <%= format_money_amount_with_estimated_eur(@project.hourly_rate, @project.hourly_rate_currency) %></p>
    <% end %>
    <% if @project.fixed_budget? %>
      <p><strong>Total Hours Sold:</strong> <%= format_hours_as_clock(@project.total_hours) %></p>
      <p><strong>Hours Remaining:</strong> <%= format_hours_as_clock(@project.remaining_hours) %></p>
    <% elsif @project.retainer? %>
      <p>
        <strong>Monthly Included:</strong>
        <%= format_hours_as_clock(@project.monthly_retainer_hours) %> default for new months,
        <%= format_hours_as_clock(@project.monthly_retainer_hours_for(Date.current)) %> this month
        <%= link_to "manage monthly hours", project_retainer_periods_path(@project, project_navigation_params), class: "btn-link" %>
      </p>
      <p>
        <strong>This Month:</strong>
        <%= format_hours_as_clock(@project.total_hours_logged_between(Date.current.all_month)) %> logged,
        <%= format_hours_as_clock(@project.monthly_retainer_remaining_hours(Date.current)) %> remaining
      </p>
    <% end %>
  </div>

  <% if @show_billing_summary %>
    <div class="card billing-summary-card">
      <div class="billing-card__header">
        <div>
          <h2 class="card-title">Billing This Month</h2>
          <p class="section-copy"><%= @billing_summary_month.strftime("%B %Y") %></p>
        </div>
      </div>

      <% billing_summary_item = project_monthly_billing_summary_item(@project, @billing_summary, @billing_summary_month) %>

      <div class="billing-breakdown billing-breakdown--single">
        <div class="billing-breakdown__item">
          <span><%= billing_summary_item[:label] %></span>
          <strong><%= billing_summary_item[:value] %></strong>
          <% billing_summary_item[:details].each do |detail| %>
            <small><%= detail %></small>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% if @project.user.pennylane_enabled? %>
    <div class="card billing-summary-card">
      <% linked_invoice_links = @project.project_pennylane_invoices.includes(:pennylane_invoice).order(created_at: :desc).to_a %>

      <div class="billing-card__header">
        <div>
          <h2 class="card-title">Billing</h2>
          <% if @project.sold_amount? && @project.quoted_fixed? %>
            <p class="section-copy">
              Sold amount: <%= format_money_amount_with_estimated_eur(@project.sold_amount, @project.sold_currency) %>
            </p>
          <% end %>
        </div>
        <span class="invoice-status <%= @project.billing_status == "invoice_linked" ? "invoice-status--paid" : "invoice-status--unbilled" %>"><%= @project.billing_status_label %></span>
      </div>

      <div class="billing-summary-row">
        <span class="billing-summary-invoice-links">
          <% if linked_invoice_links.any? %>
            <span class="billing-summary-invoices">
              <%= safe_join(linked_invoice_links.map { |link|
                invoice = link.pennylane_invoice
                link_to invoice.display_number, pdf_project_pennylane_invoice_path(@project, link), target: "_blank", rel: "noopener"
              }, ", ") %>
            </span>
          <% end %>
          <%= link_to "Manage invoices", project_pennylane_invoices_path(@project), class: "btn-link" %>
        </span>
      </div>
    </div>
  <% end %>
</div>

<div class="time-entries-page__header">
  <h2 class="time-entries-page__title">Time Entries</h2>
  <button type="button" class="btn" data-time-entry-create-toggle aria-expanded="<%= @show_log_time_form %>">+ Log Time</button>
</div>

<%= render "time_entries/filter_toolbar",
           action_path: project_path(@project),
           reset_path: project_path(@project, project_navigation_params),
           hidden_fields: { source: params[:source].presence },
           filter_start_date: @filter_start_date,
           filter_end_date: @filter_end_date,
           filter_query: @filter_query,
           filter_status: @filter_status,
           status_options: @status_filter_options,
           filter_service_name: @filter_service_name,
           service_name_options: @service_name_options,
           search_placeholder: "Description or owner",
           dom_id: "project_time_entries" %>

<div class="card time-entry-create-card" data-time-entry-create-panel <%= "hidden" unless @show_log_time_form %>>
  <%= form_with model: @time_entry, url: time_entries_path, local: true, html: { data: { time_entry_create_form: true, has_errors: false } } do |form| %>
    <%= hidden_fields_tags(return_to_project_id: @project.id, source: params[:source].presence, start_date: @filter_start_date, end_date: @filter_end_date, query: @filter_query, status: @filter_status, service_name: @filter_service_name, page: (@page if @page > 1), show_log_time: 1) %>
    <%= form.hidden_field :project_id, value: @project.id %>

    <div class="time-entry-editor-grid time-entry-editor-grid--create">
      <div>
        <%= form.label :date, "Date" %>
        <%= form.date_field :date, required: true, data: { time_entry_create_field: true } %>
      </div>
      <div>
        <%= form.label :hours, "Hours" %>
        <%= form.text_field :hours,
                            value: (@time_entry.hours_before_type_cast.presence || (@time_entry.hours.present? ? format_hours_as_clock(@time_entry.hours) : @time_entry.hours)),
                            required: true,
                            placeholder: "HH:MM or 1.25",
                            data: { time_entry_create_field: true, time_entry_create_focus: true, time_entry_hours_input: true } %>
      </div>
      <% if @service_name_options.any? %>
        <div>
          <%= form.label :service_name, "Service" %>
          <%= form.select :service_name,
                          options_for_select([["No service", ""]] + @service_name_options.map { |service_name| [service_name, service_name] }, @time_entry.service_name),
                          {},
                          data: { time_entry_create_field: true } %>
        </div>
      <% end %>
      <div class="time-entry-editor-grid__full">
        <%= form.label :description, "Description" %>
        <%= form.text_area :description,
                           rows: 4,
                           class: "time-entry-editor__textarea",
                           placeholder: "What did you work on?",
                           data: { time_entry_create_field: true } %>
      </div>
      <div class="time-entry-editor-grid__full">
        <div class="time-entry-billing-controls">
          <label>
            <input type="hidden" name="time_entry[billable]" value="0">
            <input type="checkbox" name="time_entry[billable]" value="1" <%= "checked" if @time_entry.billable? || (@time_entry.status.blank? && @project.time_entries_billable_by_default?) %> data-time-entry-billable-checkbox>
            Billable entry
          </label>
          <div class="time-entry-billing-controls__treatment">
            <%= form.label :billing_treatment, "Billing Treatment" %>
            <%= form.select :billing_treatment,
                            options_for_select(time_entry_billing_treatment_options(@project), @time_entry.billing_treatment),
                            {},
                            data: { time_entry_create_field: true } %>
          </div>
        </div>
      </div>
    </div>
    <div class="time-entry-editor-actions">
      <%= form.submit "Log Time", class: "btn secondary" %>
      <button type="button" class="btn" data-time-entry-create-cancel>Cancel</button>
    </div>
  <% end %>
</div>

<% if @time_entries.any? %>
  <%= render "time_entries/bulk_bar",
             bulk_form_id: "bulk-bill-time-entries-form",
             hidden_fields: { return_to_project_id: @project.id, source: params[:source].presence, start_date: @filter_start_date, end_date: @filter_end_date, query: @filter_query, status: @filter_status, service_name: @filter_service_name, page: (@page if @page > 1) } %>

  <%= render "time_entries/ledger",
             time_entries: @time_entries,
             page_total: @page_total,
             project: @project,
             bulk_form_id: "bulk-bill-time-entries-form",
             service_name_options: @service_name_options,
             edit_hidden_fields: { return_to_project_id: @project.id, source: params[:source].presence, start_date: @filter_start_date, end_date: @filter_end_date, query: @filter_query, status: @filter_status, service_name: @filter_service_name, page: (@page if @page > 1) },
             highlight_entry_id: params[:highlight_time_entry_id],
             highlight_state: params[:highlight_time_entry_state] %>
<% else %>
  <div class="card">
    <p>
      No time entries for this project
      <% if @date_filter_active %>
        in the selected date range
      <% elsif @filter_query.present? || @filter_status.present? || @filter_service_name.present? %>
        match these filters
      <% end %>.
      <button type="button" class="btn-link" data-time-entry-create-toggle>Log some time</button>
    </p>
  </div>
<% end %>

<%= render "time_entries/pagination",
           page: @page,
           total_pages: @total_pages,
           path_builder: ->(page_number) { project_path(@project, project_time_entries_params(page: page_number)) } %>

<%= render "time_entries/summary_toolbar",
           date_filter_active: @date_filter_active,
           filter_start_date: @filter_start_date,
           filter_end_date: @filter_end_date,
           filter_query: @filter_query,
           filter_status: @filter_status,
           status_options: @status_filter_options,
           grand_total: @grand_total,
           service_hour_totals: @service_hour_totals,
           total_entries: @total_entries,
           page: @page,
           per_page: ProjectsController::PER_PAGE,
           all_label: "All time entries for this project",
           search_label: "Searching within this project",
           export_path: nil %>

<div class="back-link-row">
  <% if project_navigation_from_projects? %>
    <%= link_to "← Back to Projects", projects_path %>
  <% else %>
    <%= link_to "← Back to #{@project.client.name}", client_path(@project.client) %>
  <% end %>
</div>
