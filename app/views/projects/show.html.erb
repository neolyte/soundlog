<div class="page-header">
  <div class="page-header__body">
    <h1 class="page-title"><%= @project.name %></h1>
    <p class="page-intro">
      <%= link_to @project.client.name, client_path(@project.client) %> •
      Owner: <%= @project.client.user.full_name %>
    </p>
    <% if @project.archived? %>
      <p class="form-note status-note">Archived project</p>
    <% end %>
  </div>
  <div class="action-buttons">
    <%= button_to(@project.active? ? "Archive" : "Unarchive",
                  project_path(@project, project_navigation_params),
                  method: :patch,
                  params: { source: params[:source], project: { active: @project.archived? } },
                  class: "btn #{@project.active? ? 'archive' : 'unarchive'}") %>
    <%= link_to "Edit", edit_project_path(@project, project_navigation_params), class: "btn secondary" %>
    <%= button_to "Delete", project_path(@project), method: :delete, class: "btn danger", form: { data: { turbo_confirm: "Are you sure you want to delete this project?" } } %>
  </div>
</div>

<% if @project.description.present? %>
  <div class="card">
    <h3 class="card-title">Description</h3>
    <p class="project-description"><%= @project.description %></p>
  </div>
<% end %>

<div class="card">
  <p><strong>Hours Logged:</strong> <%= format_hours_as_clock(@project.total_hours_logged) %></p>
  <p><strong>Unbilled Hours:</strong> <%= format_hours_as_clock(@project.unbilled_hours) %></p>
  <% if @project.fixed_budget? %>
    <p><strong>Total Hours Sold:</strong> <%= format_hours_as_clock(@project.total_hours) %></p>
    <p><strong>Hours Remaining:</strong> <%= format_hours_as_clock(@project.remaining_hours) %></p>
  <% elsif @project.monthly_retainer? %>
    <p>
      <strong>Monthly Retainer:</strong>
      <%= format_hours_as_clock(@project.monthly_retainer_hours) %> default,
      <%= format_hours_as_clock(@project.monthly_retainer_hours_for(Date.current)) %> this month
      <% if @current_retainer_period.present? %>
        <span class="form-note">override</span>
      <% end %>
      <%= link_to "manage overrides", project_retainer_periods_path(@project, project_navigation_params), class: "btn-link" %>
    </p>
    <p>
      <strong>This Month:</strong>
      <%= format_hours_as_clock(@project.total_hours_logged_between(Date.current.all_month)) %> logged,
      <%= format_hours_as_clock(@project.monthly_retainer_remaining_hours(Date.current)) %> remaining
    </p>
  <% end %>
</div>

<div class="time-entries-page__header">
  <h2 class="time-entries-page__title">Time Entries</h2>
  <button type="button" class="btn" data-time-entry-create-toggle aria-expanded="<%= @show_log_time_form %>">+ Log Time</button>
</div>

<%= render "time_entries/filter_toolbar",
           action_path: project_path(@project),
           reset_path: project_path(@project, project_navigation_params),
           hidden_fields: { source: params[:source].presence },
           filter_start_date: @filter_start_date,
           filter_end_date: @filter_end_date,
           filter_query: @filter_query,
           filter_status: @filter_status,
           status_options: @status_filter_options,
           search_placeholder: "Description or owner",
           dom_id: "project_time_entries" %>

<div class="card time-entry-create-card" data-time-entry-create-panel <%= "hidden" unless @show_log_time_form %>>
  <%= form_with model: @time_entry, url: time_entries_path, local: true, html: { data: { time_entry_create_form: true, has_errors: false } } do |form| %>
    <%= hidden_fields_tags(return_to_project_id: @project.id, source: params[:source].presence, start_date: @filter_start_date, end_date: @filter_end_date, query: @filter_query, status: @filter_status, page: (@page if @page > 1), show_log_time: 1) %>
    <%= form.hidden_field :project_id, value: @project.id %>

    <div class="time-entry-editor-grid time-entry-editor-grid--create">
      <div>
        <%= form.label :date, "Date" %>
        <%= form.date_field :date, required: true, data: { time_entry_create_field: true } %>
      </div>
      <div>
        <%= form.label :hours, "Hours" %>
        <%= form.text_field :hours,
                            value: (@time_entry.hours_before_type_cast.presence || (@time_entry.hours.present? ? format_hours_as_clock(@time_entry.hours) : @time_entry.hours)),
                            required: true,
                            placeholder: "HH:MM or 1.25",
                            data: { time_entry_create_field: true, time_entry_create_focus: true, time_entry_hours_input: true } %>
      </div>
      <div class="time-entry-editor-grid__full">
        <%= form.label :description, "Description" %>
        <%= form.text_area :description,
                           rows: 4,
                           class: "time-entry-editor__textarea",
                           placeholder: "What did you work on?",
                           data: { time_entry_create_field: true } %>
      </div>
      <div class="time-entry-editor-grid__full">
        <label>
          <input type="hidden" name="time_entry[billable]" value="0">
          <input type="checkbox" name="time_entry[billable]" value="1" <%= "checked" if @time_entry.billable? || (@time_entry.status.blank? && @project.billable?) %> data-time-entry-billable-checkbox>
          Billable entry
        </label>
      </div>
    </div>
    <div class="time-entry-editor-actions">
      <%= form.submit "Log Time", class: "btn secondary" %>
      <button type="button" class="btn" data-time-entry-create-cancel>Cancel</button>
    </div>
  <% end %>
</div>

<% if @time_entries.any? %>
  <%= render "time_entries/bulk_bar",
             bulk_form_id: "bulk-bill-time-entries-form",
             hidden_fields: { return_to_project_id: @project.id, source: params[:source].presence, start_date: @filter_start_date, end_date: @filter_end_date, query: @filter_query, status: @filter_status, page: (@page if @page > 1) } %>

  <%= render "time_entries/ledger",
             time_entries: @time_entries,
             page_total: @page_total,
             project: @project,
             bulk_form_id: "bulk-bill-time-entries-form",
             edit_hidden_fields: { return_to_project_id: @project.id, source: params[:source].presence, start_date: @filter_start_date, end_date: @filter_end_date, query: @filter_query, status: @filter_status, page: (@page if @page > 1) },
             highlight_entry_id: params[:highlight_time_entry_id],
             highlight_state: params[:highlight_time_entry_state] %>
<% else %>
  <div class="card">
    <p>
      No time entries for this project
      <% if @date_filter_active %>
        in the selected date range
      <% elsif @filter_query.present? || @filter_status.present? %>
        match these filters
      <% end %>.
      <button type="button" class="btn-link" data-time-entry-create-toggle>Log some time</button>
    </p>
  </div>
<% end %>

<%= render "time_entries/pagination",
           page: @page,
           total_pages: @total_pages,
           path_builder: ->(page_number) { project_path(@project, project_time_entries_params(page: page_number)) } %>

<%= render "time_entries/summary_toolbar",
           date_filter_active: @date_filter_active,
           filter_start_date: @filter_start_date,
           filter_end_date: @filter_end_date,
           filter_query: @filter_query,
           filter_status: @filter_status,
           status_options: @status_filter_options,
           grand_total: @grand_total,
           total_entries: @total_entries,
           page: @page,
           per_page: ProjectsController::PER_PAGE,
           all_label: "All time entries for this project",
           search_label: "Searching within this project",
           export_path: nil %>

<div class="back-link-row">
  <% if project_navigation_from_projects? %>
    <%= link_to "← Back to Projects", projects_path %>
  <% else %>
    <%= link_to "← Back to #{@project.client.name}", client_path(@project.client) %>
  <% end %>
</div>
